{
  "name": "@local/github-oauth",
  "version": "0.9.3",
  "description": "GitHub OAuth (web callback) integration for DSH: an encrypted credential vault, github_* agent tools, and a right-sidebar panel.",
  "private": true,
  "type": "commonjs",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "github",
    "oauth",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MFCJ45681/github-oauth-plugin.git"
  },
  "homepage": "https://github.com/MFCJ45681/github-oauth-plugin#readme",
  "bugs": {
    "url": "https://github.com/MFCJ45681/github-oauth-plugin/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:file": "node --test",
    "configure": "node scripts/configure.js"
  }
}
